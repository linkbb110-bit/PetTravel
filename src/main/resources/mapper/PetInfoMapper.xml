<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nfu.pettravel.mapper.PetInfoMapper">

    <resultMap id="BaseResultMap" type="com.nfu.pettravel.entity.PetInfo">
            <id property="id" column="id" />
            <result property="userId" column="user_id" />
            <result property="name" column="name" />
            <result property="breed" column="breed" />
            <result property="age" column="age" />
            <result property="avatarUrl" column="avatar_url" />
            <result property="vaccineStatus" column="vaccine_status"
                    typeHandler="com.baomidou.mybatisplus.core.handlers.MybatisEnumTypeHandler" />
            <result property="characterTags" column="character_tags" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
            <result property="isDeleted" column="is_deleted" />
    </resultMap>

    <sql id="Base_Column_List">
        id,user_id,name,breed,age,avatar_url,
        vaccine_status,character_tags,create_time,update_time,is_deleted
    </sql>

    <update id="updateOwned">
        UPDATE pet_info
        SET name = #{pet.name},
            breed = #{pet.breed},
            age = #{pet.age},
            avatar_url = #{pet.avatarUrl},
            vaccine_status = #{pet.vaccineStatus},
            character_tags = #{pet.characterTags},
            update_time = CURRENT_TIMESTAMP
        WHERE id = #{pet.id}
          AND user_id = #{userId}
          AND is_deleted = 0
    </update>

    <update id="logicalDeleteOwned">
        UPDATE pet_info
        SET is_deleted = 1,
            update_time = CURRENT_TIMESTAMP
        WHERE id = #{petId}
          AND user_id = #{userId}
          AND is_deleted = 0
    </update>
</mapper>
